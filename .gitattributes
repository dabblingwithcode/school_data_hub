# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Dart files
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# JSON files
*.json text eol=lf

# Markdown and documentation
*.md text eol=lf

# Git files
.gitattributes text eol=lf
.gitignore text eol=lf

# Windows specific files should keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.ttf binary
*.otf binary